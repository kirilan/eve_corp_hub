{
  "name": "eve_corp_hub",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:dev": "pglite-server --db=./.data/pglite --port=54329",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.mts",
    "super-user": "tsx --env-file-if-exists=.env.local scripts/super-user.mts",
    "vercel-build": "tsx scripts/migrate.mts --deploy && next build"
  },
  "dependencies": {
    "@vercel/functions": "3.10.1",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.12",
    "next": "16.4.1",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.4"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "24.x"
  }
}
