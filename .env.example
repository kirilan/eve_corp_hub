# Public base URL of this deployment; the EVE application's callback must be <APP_URL>/auth/callback.
APP_URL=http://localhost:3003

# From https://developers.eveonline.com/applications (use a separate application for local dev).
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=

# 32 random bytes, base64: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# How CCP can reach you about this app's ESI traffic (e.g. "admin@example.com" or "EVE: Your Name").
ESI_CONTACT=

# Local dev: `pnpm db:dev` serves PGlite on this port. Production: Neon's pooled connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable
# PGlite has one real connection; keep 1 locally so transactions never interleave.
DATABASE_POOL_MAX=1

# Production only: Vercel Cron authenticates the daily wallet sync with it (openssl rand -hex 32).
# CRON_SECRET=
